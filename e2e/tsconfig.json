// Playwright strips types without checking them, so this is only for type
// checking, which yarn pretest:e2e runs before the tests.
{
  "extends": "../tsconfig.json",
  "compilerOptions": {
    // Check the types, but don't write any JavaScript
    "noEmit": true,

    // The main config's rootDir is ./src, which doesn't contain this folder
    "rootDir": "..",

    // Check our own files, not the type files of our dependencies
    "skipLibCheck": true,

    // Leaves out Mocha, whose test globals clash with Playwright's
    "types": ["node"]
  },

  // Check this folder instead of the main config's ./src
  "include": ["./**/*"],
  "exclude": []
}
